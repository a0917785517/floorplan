        <mxCell id="layer_flow" value="動線建議" parent="0" /><mxCell id="f_door" parent="layer_flow" value="後門　進出貨（唯一出入口）" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=10;fontColor=#2E7D32;fontSize=30;fontStyle=1;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1075" y="1660" as="sourcePoint" /><mxPoint x="1075" y="1450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f_frontX" parent="layer_flow" value="前門&lt;br&gt;停用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=4;fontColor=#C62828;fontSize=26;fontStyle=1;verticalAlign=middle;align=center;dashed=1;dashPattern=8 8;" vertex="1"><mxGeometry as="geometry" x="2450" y="1452" width="190" height="190" /></mxCell><mxCell id="f_spine" parent="layer_flow" value="底部主幹通道（雙向）" style="endArrow=classic;html=1;rounded=0;strokeColor=#1565C0;strokeWidth=9;fontColor=#1565C0;fontSize=28;fontStyle=1;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1075" y="1392" as="sourcePoint" /><mxPoint x="2540" y="1392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f_aisleL" parent="layer_flow" value="單線單車" style="endArrow=classic;html=1;rounded=0;strokeColor=#546E7A;strokeWidth=6;fontColor=#546E7A;fontSize=24;fontStyle=1;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;dashPattern=10 8;" edge="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1176" y="1305" as="sourcePoint" /><mxPoint x="1176" y="250" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f_aisleR" parent="layer_flow" value="單線單車" style="endArrow=classic;html=1;rounded=0;strokeColor=#546E7A;strokeWidth=6;fontColor=#546E7A;fontSize=24;fontStyle=1;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;dashPattern=10 8;" edge="1"><mxGeometry as="geometry" relative="1"><mxPoint x="2501" y="1305" as="sourcePoint" /><mxPoint x="2501" y="250" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f_clear" parent="layer_flow" value="後門口&lt;br&gt;淨空" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#F57F17;strokeWidth=4;fontColor=#F57F17;fontSize=22;fontStyle=1;verticalAlign=top;align=center;dashed=1;dashPattern=8 8;" vertex="1"><mxGeometry as="geometry" x="985" y="1450" width="180" height="150" /></mxCell><mxCell id="f_zoneA" parent="layer_flow" value="① 高頻區：醫療彩盒／包材（已調至最靠後門）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E7D32;strokeWidth=5;fontColor=#2E7D32;fontSize=28;fontStyle=1;verticalAlign=top;align=center;dashed=1;dashPattern=8 8;" vertex="1"><mxGeometry as="geometry" x="480" y="858" width="1180" height="384" /></mxCell><mxCell id="f_zoneC" parent="layer_flow" value="③ 低頻・泡棉/色系・B01固定 → 移至最深處（遠門）" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#8D6E63;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="1900" y="300" width="760" height="120" /></mxCell><mxCell id="f_legend" parent="layer_flow" vertex="1" value="【動線建議圖層｜單一後門版｜可於 draw.io 圖層面板單獨開關或刪除】&lt;br&gt;前門停用 → 後門為唯一進出口：最高頻的「醫療彩盒/包材」已由最深處(原前門側)調到最靠後門的 ① 高頻區&lt;br&gt;泡棉/色系等低頻與 B01固定 留在遠門深處；棧板110/走道130，縱走道一次一台、進退同道&lt;br&gt;後門口淨空區勿堆放(留整趟貨梯量暫存)；行進避開門旁 72cm 柱之迴轉盲點" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;strokeWidth=2;fontColor=#333333;fontSize=28;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="86" y="-300" width="2200" height="240" as="geometry" /></mxCell></root>
